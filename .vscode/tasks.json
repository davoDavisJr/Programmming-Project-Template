{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: Build src/main.cpp",
      "type": "shell",
      "command": "clang++",
      "args": [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-g",
        "${workspaceFolder}/src/main.cpp",
        "-I",
        "${workspaceFolder}/include",
        "-o",
        "${workspaceFolder}/build/main"
      ],
      "windows": {
        "args": [
          "-std=c++20",
          "-Wall",
          "-Wextra",
          "-Wpedantic",
          "-g",
          "${workspaceFolder}/src/main.cpp",
          "-I",
          "${workspaceFolder}/include",
          "-o",
          "${workspaceFolder}/build/main.exe"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "C++: Run",
      "type": "shell",
      "command": "${workspaceFolder}/build/main",
      "windows": {
        "command": "${workspaceFolder}/build/main.exe"
      },
      "dependsOn": "C++: Build src/main.cpp",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "AI: Status",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/toggle-vscode-ai.ps1",
        "-Mode",
        "status"
      ],
      "problemMatcher": []
    },
    {
      "label": "Git: Show Status",
      "type": "shell",
      "command": "git",
      "args": [
        "status",
        "--short",
        "--branch"
      ],
      "problemMatcher": []
    }
  ]
}
