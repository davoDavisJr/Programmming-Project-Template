{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MARIE: Check Setup",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/marie-check.ps1"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "MARIE: Show Source Path",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Write-Output '${workspaceFolder}/src/main.mas'"
      ],
      "problemMatcher": []
    },
    {
      "label": "Git: Show Status",
      "type": "shell",
      "command": "git",
      "args": [
        "status",
        "--short",
        "--branch"
      ],
      "problemMatcher": []
    }
  ]
}
