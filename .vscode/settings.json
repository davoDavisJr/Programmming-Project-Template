{
  "python.defaultInterpreterPath": "python",
  "python.envFile": "${workspaceFolder}/.vscode/.python-policy.env",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/tools/python_policy",
    "${workspaceFolder}/tools"
  ],
  "editor.bracketPairColorization.enabled": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.detectIndentation": false,
  "editor.fontSize": 16,
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.indentation": true,
  "editor.lineHeight": 22,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "selection",
  "editor.rulers": [
    88,
    100
  ],
  "editor.semanticHighlighting.enabled": true,
  "editor.smoothScrolling": true,
  "editor.tabSize": 4,
  "explorer.compactFolders": false,
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "search.exclude": {
    "**/build": true,
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true
  },
  "terminal.integrated.env.windows": {
    "MONASH_PYTHON_POLICY_ENFORCE": "1",
    "MONASH_PYTHON_POLICY_FILE": "${workspaceFolder}\\docs\\environment\\eng1014.yaml",
    "PYTHONPATH": "${workspaceFolder}\\tools\\python_policy"
  },
  "terminal.integrated.env.linux": {
    "MONASH_PYTHON_POLICY_ENFORCE": "1",
    "MONASH_PYTHON_POLICY_FILE": "${workspaceFolder}/docs/environment/eng1014.yaml",
    "PYTHONPATH": "${workspaceFolder}/tools/python_policy"
  },
  "terminal.integrated.env.osx": {
    "MONASH_PYTHON_POLICY_ENFORCE": "1",
    "MONASH_PYTHON_POLICY_FILE": "${workspaceFolder}/docs/environment/eng1014.yaml",
    "PYTHONPATH": "${workspaceFolder}/tools/python_policy"
  },
  "terminal.integrated.enablePersistentSessions": true,
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 16
}
