#!/usr/bin/env sh
# Keep this file UTF-8 without BOM and LF-only.

run_with_python() {
  script="$1"
  shift
  if [ -n "${MONASH_PYTHON_EXE:-}" ]; then
    "${MONASH_PYTHON_EXE}" "$script" "$@"
  elif repo_python="$(git config --local --get monash.pythonPath 2>/dev/null)"; [ -n "${repo_python}" ]; then
    "${repo_python}" "$script" "$@"
  elif command -v python >/dev/null 2>&1; then
    python "$script" "$@"
  elif command -v py >/dev/null 2>&1; then
    py -3.10 "$script" "$@"
  elif command -v python3 >/dev/null 2>&1; then
    python3 "$script" "$@"
  elif command -v powershell.exe >/dev/null 2>&1; then
    ps_python="$(powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "\$cmd = Get-Command python.exe, py.exe, python3.exe -ErrorAction SilentlyContinue | Select-Object -First 1; if (\$cmd) { [Console]::Out.Write(\$cmd.Source) }")"
    if [ -z "$ps_python" ]; then
      echo "[MONASH-POLICY] No usable Python interpreter found for hook checks." >&2
      echo "[MONASH-POLICY] Install Python 3.10.11 and set: git config monash.pythonPath <path-to-python>" >&2
      return 127
    fi
    if command -v cygpath >/dev/null 2>&1; then
      ps_python="$(cygpath -u "$ps_python")"
    fi
    case "$ps_python" in
      *py.exe|*py.EXE) "$ps_python" -3.10 "$script" "$@" ;;
      *) "$ps_python" "$script" "$@" ;;
    esac
  else
    echo "[MONASH-POLICY] No usable Python interpreter found for hook checks." >&2
    echo "[MONASH-POLICY] Install Python 3.10.11 and set: git config monash.pythonPath <path-to-python>" >&2
    return 127
  fi
}

if [ "${MONASH_TEXT_POLICY_ENFORCE:-1}" = "1" ]; then
  run_with_python tools/text_policy/check_text_format.py --changed-only || exit $?
else
  echo "[TEXT-POLICY] pre-commit bypassed by MONASH_TEXT_POLICY_ENFORCE=0"
fi

if [ "${MONASH_PYTHON_POLICY_ENFORCE:-1}" != "1" ]; then
  echo "[MONASH-POLICY] pre-commit bypassed by MONASH_PYTHON_POLICY_ENFORCE=0"
  exit 0
fi

if git diff --cached --name-only --diff-filter=ACMR | grep -E '\.py$' >/dev/null 2>&1; then
  run_with_python tools/python_policy/check_imports.py --changed-only
fi
